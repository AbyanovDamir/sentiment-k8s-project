{
  "uid": "sentiment-lab-verified",
  "title": "Sentiment API — мониторинг",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU приложения",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "cores",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(pod) (rate(process_cpu_time_ns_total{namespace=\"sentiment\"}[1m])) / 1e9",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Запросы API в секунду",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{namespace=\"sentiment\",uri=\"/api/sentiment\"}[1m]))",
          "legendFormat": "{{deployment}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Реплики со сбором метрик",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(up{job=\"sentiment\",namespace=\"sentiment\"} == 1)",
          "legendFormat": "Цели UP"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Задержка API p95",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by(le)(rate(http_server_requests_seconds_bucket{namespace=\"sentiment\",uri=\"/api/sentiment\"}[2m])))",
          "legendFormat": "{{deployment}}"
        }
      ]
    }
  ]
}
